LAUNCHKIT_APP_NAME=AI Launch Kit Backend
LAUNCHKIT_ENVIRONMENT=local
LAUNCHKIT_DEBUG=false
LAUNCHKIT_LOG_LEVEL=INFO
LAUNCHKIT_LOG_JSON=false

# OpenRouter is optional until an OpenRouter-backed capability is constructed.
LAUNCHKIT_OPENROUTER_API_KEY=
LAUNCHKIT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LAUNCHKIT_SITE_URL=http://localhost:8000
LAUNCHKIT_OPENROUTER_APP_TITLE=LaunchKit Generator
LAUNCHKIT_GENERATION_MODEL=anthropic/claude-sonnet-5
LAUNCHKIT_UTILITY_MODEL=
LAUNCHKIT_IMAGE_MODEL=google/gemini-2.5-flash-image
LAUNCHKIT_PEXELS_API_KEY=
LAUNCHKIT_PEXELS_BASE_URL=https://api.pexels.com/v1
LAUNCHKIT_OPENROUTER_MAX_CONCURRENT=2
LAUNCHKIT_OPENROUTER_MIN_REQUEST_GAP_MS=250
LAUNCHKIT_OPENROUTER_SEQUENTIAL=false
LAUNCHKIT_OPENROUTER_RETRY_ATTEMPTS=6
