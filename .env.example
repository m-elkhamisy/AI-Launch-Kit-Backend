LAUNCHKIT_APP_NAME=AI Launch Kit Backend
LAUNCHKIT_ENVIRONMENT=local
LAUNCHKIT_DEBUG=false
LAUNCHKIT_LOG_LEVEL=INFO
LAUNCHKIT_LOG_JSON=false

# OpenRouter is optional until an OpenRouter-backed capability is constructed.
LAUNCHKIT_OPENROUTER_API_KEY=
LAUNCHKIT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LAUNCHKIT_SITE_URL=http://localhost:8000
LAUNCHKIT_OPENROUTER_APP_TITLE=LaunchKit Generator
LAUNCHKIT_GENERATION_MODEL=anthropic/claude-sonnet-5
LAUNCHKIT_UTILITY_MODEL=
LAUNCHKIT_IMAGE_MODEL=google/gemini-2.5-flash-image
LAUNCHKIT_PEXELS_API_KEY=
LAUNCHKIT_PEXELS_BASE_URL=https://api.pexels.com/v1
LAUNCHKIT_OPENROUTER_MAX_CONCURRENT=2
LAUNCHKIT_OPENROUTER_MIN_REQUEST_GAP_MS=250
LAUNCHKIT_OPENROUTER_SEQUENTIAL=false
LAUNCHKIT_OPENROUTER_RETRY_ATTEMPTS=6

# v0 is optional until v0 generation or hosting is selected.
LAUNCHKIT_V0_API_KEY=
LAUNCHKIT_V0_BASE_URL=https://api.v0.dev/v1
LAUNCHKIT_V0_MODEL=v0-max

# Submission persistence. S3 credentials use the standard AWS environment/role chain.
LAUNCHKIT_LOCAL_DATA_DIR=local_data
LAUNCHKIT_S3_BUCKET=
LAUNCHKIT_S3_PREFIX=submissions/
LAUNCHKIT_AWS_REGION=me-central-1

# Vercel claim deployment is optional until the ownership-transfer flow is used.
LAUNCHKIT_VERCEL_TOKEN=
LAUNCHKIT_VERCEL_TEAM_ID=
LAUNCHKIT_VERCEL_BASE_URL=https://api.vercel.com
LAUNCHKIT_CLAIM_RETURN_URL=http://localhost:8000/

# InnovationCity OAuth PKCE (app-auth-service). Register client_id + URIs with WeCan.
# Sandbox: https://app-sandbox.innovationcity.com  Prod: https://app.innovationcity.com
LAUNCHKIT_AUTH_BASE_URL=https://app-sandbox.innovationcity.com
LAUNCHKIT_AUTH_CLIENT_ID=
LAUNCHKIT_AUTH_REDIRECT_URI=http://localhost:8000/auth/callback
LAUNCHKIT_AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/?auth=logged_out
LAUNCHKIT_AUTH_FRONTEND_URL=http://localhost:5173
LAUNCHKIT_AUTH_SESSION_SECRET=dev-only-change-me
LAUNCHKIT_AUTH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
